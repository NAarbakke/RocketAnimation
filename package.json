{
  "name": "kestrel-labs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cad": "cad/.venv/Scripts/python cad/srm.py",
    "cad:watch": "cad/.venv/Scripts/python cad/srm.py --watch",
    "video": "vite build --base ./ --outDir video/site --emptyOutDir && npx -y hyperframes render video --output renders/srm.mp4"
  },
  "dependencies": {
    "three": "0.147.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "0.147.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
